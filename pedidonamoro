            </p>

            <button onclick="closeModal()" class="w-full py-3 bg-rose-500 hover:bg-rose-600 text-white font-bold rounded-xl transition duration-200 shadow-lg">
                Te amo! 🥰
            </button>
        </div>
    </div>

    <!-- JavaScript Logic -->
    <script>
        // 1. Audio Toggle Logic
        let isPlaying = false;
        const bgMusic = document.getElementById('bgMusic');
        const musicIcon = document.getElementById('musicIcon');
        const musicText = document.getElementById('musicText');

        function toggleMusic() {
            if (isPlaying) {
                bgMusic.pause();
                musicIcon.classList.remove('fa-compact-disc', 'fa-spin');
                musicIcon.classList.add('fa-music');
                musicText.innerText = "Nossa Música";
            } else {
                bgMusic.play().then(() => {
                    musicIcon.classList.remove('fa-music');
                    musicIcon.classList.add('fa-compact-disc', 'fa-spin');
                    musicText.innerText = "Tocando...";
                }).catch(err => {
                    console.log("Audio block active:", err);
                });
            }
            isPlaying = !isPlaying;
        }

        // Tentar dar play automático ao primeiro clique em qualquer lugar da tela
        document.body.addEventListener('click', function startAudioOnFirstTouch() {
            if (!isPlaying) {
                toggleMusic();
            }
            document.body.removeEventListener('click', startAudioOnFirstTouch);
        }, { once: true });

        // 2. Playful Movable "NO" Button Logic
        const noBtn = document.getElementById('noBtn');
        let countMoves = 0;

        function moveButton() {
            countMoves++;
            const container = noBtn.parentElement;
            
            // Generate random positions relative to screen layout
            const maxX = window.innerWidth > 400 ? 120 : 60;
            const maxY = 100;

            const randomX = (Math.random() - 0.5) * maxX * 2;
            const randomY = (Math.random() - 0.5) * maxY * 2;

            noBtn.style.position = 'relative';
            noBtn.style.transform = `translate(${randomX}px, ${randomY}px)`;
            
            // Changing messages on the button if she keeps trying to click "NO"
            const funMessages = ["Certeza?", "Pensa bem!", "Nem vem! 🙈", "Tentativa em vão! 😉", "Resposta errada! 💕"];
            if (countMoves > 1) {
                noBtn.innerText = funMessages[Math.floor(Math.random() * funMessages.length)];
            }
        }

        // 3. Acceptance / YES Logic & Confetti Explosions
        function acceptProposal() {
            // Trigger Confetti Effect
            const duration = 4 * 1000;
            const end = Date.now() + duration;

            (function frame() {
                // Heart confetti
                confetti({
                    particleCount: 5,
                    angle: 60,
                    spread: 55,
                    origin: { x: 0 },
                    colors: ['#f43f5e', '#fb7185', '#ffffff']
                });
                confetti({
                    particleCount: 5,
                    angle: 120,
                    spread: 55,
                    origin: { x: 1 },
                    colors: ['#f43f5e', '#fb7185', '#ffffff']
                });

                if (Date.now() < end) {
                    requestAnimationFrame(frame);
                }
            })();

            // Show Celebration Modal
            const modal = document.getElementById('modal');
            const modalContent = document.getElementById('modalContent');
            
            modal.classList.remove('hidden');
            setTimeout(() => {
                modal.classList.remove('opacity-0');
                modalContent.classList.remove('scale-90');
                modalContent.classList.add('scale-100');
            }, 50);
        }

        function closeModal() {
            const modal = document.getElementById('modal');
            modal.classList.add('opacity-0');
            setTimeout(() => {
                modal.classList.add('hidden');
            }, 300);
        }

        // 4. Floating Petals Generator
        function createPetals() {
            const container = document.getElementById('petals-container');
            const petalCount = 15;

            for (let i = 0; i < petalCount; i++) {
                const petal = document.createElement('div');
                petal.classList.add('petal');
                
                // Randomize sizes and speeds
                const size = Math.random() * 15 + 10;
                petal.style.width = `${size}px`;
                petal.style.height = `${size + 5}px`;
                petal.style.left = `${Math.random() * 100}%`;
                petal.style.animationDuration = `${Math.random() * 5 + 7}s`;
                petal.style.animationDelay = `${Math.random() * 5}s`;
                
                container.appendChild(petal);
            }
        }

        window.onload = function() {
            createPetals();
        };
    </script>
</body>
</html>
