        <div class="glass-card max-w-sm w-full rounded-3xl p-8 text-center border border-rose-400/40 relative transform scale-90 transition-transform duration-300" id="modalContent">
            
            <div class="w-20 h-20 mx-auto mb-4 rounded-full bg-rose-500/20 flex items-center justify-center border border-rose-400/30">
                <i class="fas fa-ring text-4xl text-rose-400 animate-bounce"></i>
            </div>

