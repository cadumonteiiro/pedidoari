    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Canvas Confetti Library -->
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@600;700&family=Plus+Jakarta+Sans:wght@300;400;600&display=swap" rel="stylesheet">

    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background: linear-gradient(135deg, #2b0814 0%, #4a1226 50%, #1f050e 100%);
            color: #fce7f3;
            overflow-x: hidden;
            min-height: 100vh;
        }

        .font-handwriting {
            font-family: 'Dancing Script', cursive;
        }

        /* Ambient floating petals/hearts animation */
        .petal {
            position: absolute;
            background: radial-gradient(circle, #f43f5e 0%, #9f1239 100%);
            border-radius: 150% 0 150% 0;
            animation: animatePetal 10s linear infinite;
            opacity: 0.6;
            pointer-events: none;
            z-index: 1;
        }

        @keyframes animatePetal {
            0% {
                top: -10%;
                transform: translateX(0) rotate(0deg);
                opacity: 0.8;
            }
            100% {
                top: 110%;
                transform: translateX(100px) rotate(360deg);
                opacity: 0;
            }
        }

        /* Glassmorphism card */
        .glass-card {
            background: rgba(255, 255, 255, 0.07);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.15);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
        }

        /* Polaroid styling */
        .polaroid {
            background-color: #ffffff;
            box-shadow: 0 15px 35px rgba(0,0,0,0.5);
            transform: rotate(-2deg);
            transition: all 0.3s ease;
        }

        .polaroid:hover {
            transform: rotate(0deg) scale(1.02);
        }

        /* Heart beat animation */
        .pulse-heart {
            animation: heartBeat 1.4s infinite ease-in-out;
        }

        @keyframes heartBeat {
            0% { transform: scale(1); }
            14% { transform: scale(1.15); }
            28% { transform: scale(1); }
            42% { transform: scale(1.15); }
            70% { transform: scale(1); }
        }

        /* Glowing button */
        .btn-glow {
            box-shadow: 0 0 20px rgba(244, 63, 94, 0.5);
            transition: all 0.3s ease;
        }
        
        .btn-glow:hover {
            box-shadow: 0 0 30px rgba(244, 63, 94, 0.8);
            transform: scale(1.05);
        }
    </style>
</head>
<body class="relative flex flex-col justify-between items-center px-4 py-8 max-w-md mx-auto">

    <!-- Ambient Animation Layer -->
    <div id="petals-container" class="fixed inset-0 pointer-events-none z-0"></div>

    <!-- Floating Audio Control -->
    <div class="fixed top-4 right-4 z-50">
        <button id="musicToggle" onclick="toggleMusic()" class="glass-card text-rose-200 p-3 rounded-full flex items-center gap-2 border border-rose-400/30 text-sm font-medium hover:bg-rose-950/50 transition duration-300 shadow-lg">
