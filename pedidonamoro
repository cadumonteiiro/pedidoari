            </div>
            <p class="font-handwriting text-2xl text-slate-800 font-bold">Leia com atenção ❤️</p>
        </div>

        <!-- Romantic Content Card -->
        <div class="glass-card w-full rounded-3xl p-6 sm:p-8 text-center border border-rose-400/20 mb-6">
            
            <div class="inline-block p-3 rounded-full bg-rose-500/10 mb-4 border border-rose-500/20">
                <i class="fas fa-heart text-3xl text-rose-400 pulse-heart"></i>
            </div>

            <h1 class="font-handwriting text-4xl sm:text-5xl text-rose-200 mb-4 font-bold">
