                <button id="noBtn" onmouseover="moveButton()" onclick="moveButton()" class="w-full sm:w-auto px-8 py-3.5 bg-white/10 text-rose-200 border border-rose-300/30 rounded-full font-semibold text-lg hover:bg-white/20 transition-all duration-200">
