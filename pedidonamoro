            </h2>

            <!-- Action Buttons -->
            <div class="relative min-h-[120px] flex flex-col sm:flex-row items-center justify-center gap-4">
                
                <!-- YES BUTTON -->
                <button id="yesBtn" onclick="acceptProposal()" class="btn-glow w-full sm:w-auto px-8 py-3.5 bg-gradient-to-r from-rose-500 to-pink-600 text-white font-bold rounded-full text-lg shadow-xl hover:from-rose-600 hover:to-pink-700 active:scale-95 transition-all duration-200">
                    SIM! <i class="fas fa-heart ml-2"></i>
                </button>

